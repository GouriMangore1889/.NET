@page
@model CRMProject.Pages.Customer.IndexModel
@{
    ViewData["Title"] = "Customer list";
}

<h1>@ViewData["Title"]</h1>

    <div>
        <table class="table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var customer in Model.listCustomers)
                {
                    <tr>
                        <td>@customer.Id</td>
                        <td>@customer.Name</td>
                        <td>@customer.Email</td>
                        <td>@customer.Phone</td>
                        <td>
                            <a asp-page="/Customer/Edit"
                                asp-route-id="@customer.Id"
                                class="btn btn-primary">
                                Edit
                                </a>
                            <a asp-page="/Customer/Delete"
                                asp-route-id="@customer.Id"
                                class="btn btn-danger">
                                Delete
                                </a>
                            </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
